# Le serveur lit les variables de l'environnement (il ne charge pas ce fichier automatiquement).
HOST=0.0.0.0
PORT=4173

# Authentification
YVS_AUTH_REQUIRED=true
YVS_ALLOW_REGISTRATION=true
# Obligatoire si plusieurs instances partagent la même base : openssl rand -base64 48
YVS_SESSION_SECRET=replace-with-a-long-random-secret
# Laisser non défini pour détection automatique via X-Forwarded-Proto.
# YVS_COOKIE_SECURE=true

# Développement : SQLite local persistant (valeur par défaut si absent)
YVS_DATABASE_URL=file:data/yallah-viral-studio.db

# Production cloud libSQL/Turso : décommenter et renseigner dans le gestionnaire de secrets.
# YVS_DATABASE_URL=libsql://your-database.turso.io
# YVS_DATABASE_AUTH_TOKEN=replace-with-provider-token

# Runtime TTS isolé créé par npm run setup:voices
# YVS_PYTHON=.venv/bin/python
# YVS_MODELS_DIR=assets/models
# auto (Piper puis fallback), piper (strict) ou espeak (forcé)
# YVS_TTS_ENGINE=auto
