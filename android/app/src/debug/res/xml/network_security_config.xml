<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may connect to a LAN development server. Release remains HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
