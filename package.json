{
  "name": "yallah-viral-studio",
  "version": "2.4.0",
  "description": "Studio sécurisé de création automatique d’affiches et vidéos IA open source à partir d’une demande libre (MP4 H.264/AAC, voix, musique, sous-titres et libSQL).",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npm run setup:fonts && npm run setup:voices",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check lib/*.mjs && node --check scripts/*.mjs && node --check src/main.js",
    "stub:llm": "node scripts/llm-stub.mjs",
    "setup:fonts": "node scripts/setup-fonts.mjs",
    "setup:voices": "node scripts/setup-voices.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "verify": "npm run check && npm test",
    "test:all": "npm run verify && npm run test:e2e",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "android:check": "node scripts/check-android.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:build:release": "node scripts/build-android.mjs --release"
  },
  "keywords": [
    "tiktok",
    "reels",
    "video",
    "yallah-services",
    "ai-content"
  ],
  "author": "Yallah Services",
  "license": "UNLICENSED",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@libsql/client": "^0.17.4",
    "@napi-rs/canvas": "^1.0.8"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "wawoff2": "^2.0.1"
  }
}
